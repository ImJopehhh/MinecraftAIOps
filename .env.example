# Pterodactyl Panel Configuration
# URL of your Pterodactyl panel (without trailing slash)
PTERO_URL=https://panel.example.com

# Client API Key (starts with ptlc_ - generate from Account Settings -> API Credentials)
PTERO_CLIENT_KEY=ptlc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Default Server Identifier (short identifier or UUID from the server URL)
PTERO_SERVER_ID=xxxxxxxx

